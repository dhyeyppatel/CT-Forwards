# ==============================================================================
# CT-Forwards Serverless — Environment Variables
# ==============================================================================

# ── Mode ──────────────────────────────────────────────────────────────────────
# userbot : Uses Telethon MTProto via cron/webhook pulling (no 24/7 process)
# bot     : Uses Bot API via instant Telegram Webhooks
# both    : Uses both modes
MODE=userbot

# ── Userbot Mode (Telethon) ───────────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Telethon StringSession (generate by running python ../generate_session.py)
SESSION_STRING=1BJWap1wB...

# ── Bot Mode & Admin Panel (python-telegram-bot) ──────────────────────────────
# Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of Telegram user IDs authorized to use the admin panel
ADMIN_IDS=123456789,987654321

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# Connection string from MongoDB Atlas (e.g. mongodb+srv://user:pass@cluster.mongodb.net/...)
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ct_forwards

# ── Webhook & Security ────────────────────────────────────────────────────────
# Your public deployed URL on Vercel (without trailing slash)
WEBHOOK_URL=https://your-app.vercel.app

# Secret token used to authenticate cron requests (prevents unauthorized triggers)
# Matches Authorization: Bearer <CRON_SECRET> sent by Vercel Cron
CRON_SECRET=your_random_secret_token_here_32chars

# ── Initial Configuration (Seeded to DB on first launch only) ─────────────────
# Format: SOURCE:TARGET[,TARGET2];SOURCE2:TARGET3
# Values can be numeric IDs (-100...) or public usernames (@channel)
FORWARD_RULES=-1001234567890:-1009876543210

# Comma or newline-separated words/phrases to filter out
SKIP_TERMS=ad,sponsored,join now

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
