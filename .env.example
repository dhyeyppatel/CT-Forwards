# ============================================================
#  MN Auto Forward Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ── MODE ─────────────────────────────────────────────────────
# Choose which mode to run:
#   userbot  → Telethon userbot (reads any public channel, no membership needed)
#   bot      → Bot API polling  (bot must be member of source channels)
MODE=userbot

# ── USERBOT MODE SETTINGS (required when MODE=userbot) ───────
# Get API_ID and API_HASH from https://my.telegram.org → App
API_ID=12345678
API_HASH=your_api_hash_here

# SESSION_STRING: For Koyeb/cloud deployment (no local file needed).
# Generate it locally by running:  python generate_session.py
# Then paste the output here.
SESSION_STRING=

# PHONE: Only needed the first time you run locally to generate SESSION_STRING.
# Not used on Koyeb (SESSION_STRING takes priority).
# PHONE=+1234567890

# ── BOT MODE SETTINGS (required when MODE=bot) ────────────────
# Get your bot token from @BotFather on Telegram
# BOT_TOKEN=your_bot_token_here

# ── FORWARDING RULES (required for both modes) ────────────────
# Format: SOURCE_ID:TARGET_ID
# Separate multiple targets with comma, multiple rules with semicolon.
#
# Examples:
#   Single rule:            -100111111:-100222222
#   Multiple targets:       -100111111:-100222222,-100333333
#   Multiple sources:       -100111111,-100222222:-100333333
#   Multiple rules:         -100111111:-100222222;-100444444:-100555555
#
# Tip: Get channel IDs by forwarding a message to @userinfobot
FORWARD_RULES=-100111111:-100222222

# ── SKIP TERMS (optional) ─────────────────────────────────────
# Messages containing any of these words/phrases will be skipped.
# Comma or semicolon separated. Case-insensitive.
# SKIP_TERMS=spam,buy now,advertisement,promo

# ── HEALTH CHECK PORT (optional) ─────────────────────────────
# Set PORT to enable a lightweight HTTP health-check endpoint.
# Useful for Koyeb Web Service type or uptime monitors.
# For Koyeb Worker type, leave this unset.
# PORT=8080

# ── LOGGING ───────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# LOG_LEVEL=INFO
