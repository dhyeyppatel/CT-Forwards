# ============================================================
#  Common Thread Auto Forward Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ── MODE ─────────────────────────────────────────────────────
# userbot  → Telethon userbot (reads any public channel freely)
# bot      → Bot API polling (bot must be member of source channels)
# both     → Run userbot + bot simultaneously
MODE=userbot

# ── MONGODB ────────────────────────────────────────────────────
# MongoDB connection string (required).
MONGO_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority
# Optional: custom database name (default: ct_forwards)
# MONGO_DB_NAME=ct_forwards

# ── ADMIN IDs ─────────────────────────────────────────────────
# Comma-separated Telegram user IDs who can manage the bot.
# Get your ID: message @userinfobot on Telegram.
# REQUIRED to use the management panel.
ADMIN_IDS=123456789,987654321

# ── BOT TOKEN (required for management bot + bot-mode forwarding) ─
# Get from @BotFather on Telegram.
# Required regardless of mode — the management interface uses it.
BOT_TOKEN=your_bot_token_here

# ── USERBOT MODE SETTINGS (required when MODE=userbot or MODE=both) ─
# Get API_ID and API_HASH from https://my.telegram.org → App
API_ID=12345678
API_HASH=your_api_hash_here

# SESSION_STRING: For Koyeb/cloud deployment (no local file needed).
# Generate it locally by running:  python generate_session.py
# Then paste the output here.
SESSION_STRING=

# PHONE: Only needed the first time you run locally to generate SESSION_STRING.
# PHONE=+1234567890

# ── FORWARDING RULES (seeded into DB on first run) ────────────
# After first run, manage rules via the management bot instead.
# Format: SOURCE_ID:TARGET_ID
# Multiple targets: -100111111:-100222222,-100333333
# Multiple rules:   -100111111:-100222222;-100444444:-100555555
# Multiple sources: -100111111,-100222222:-100333333
FORWARD_RULES=-100111111:-100222222

# ── SKIP TERMS (seeded into DB on first run) ──────────────────
# Comma or semicolon separated. Managed via bot after first run.
# SKIP_TERMS=spam,buy now,advertisement

# ── HEALTH CHECK PORT (optional) ─────────────────────────────
# Enable a lightweight HTTP health-check endpoint.
# Required for Koyeb Web Service type. Leave unset for Worker type.
# PORT=8080

# ── LOGGING ───────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR  (default: INFO)
# LOG_LEVEL=INFO
